<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="10dp"
    android:padding="8dp"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/articleClip"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/articleClip"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/articleClip"
        android:layout_marginStart="5dp"
        android:text="TITLE" />

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="14sp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/title"
        android:layout_marginStart="5dp"
        android:text="DESCRIPTION" />

    <TextView
        android:id="@+id/dateTime"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_height="wrap_content"
        android:text="DateTime" />

    <TextView
        android:id="@+id/source"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/articleClip"
        app:layout_constraintTop_toBottomOf="@+id/articleClip"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:text="TextView" />


</androidx.constraintlayout.widget.ConstraintLayout>